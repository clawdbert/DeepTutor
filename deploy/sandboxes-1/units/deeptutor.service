[Unit]
Description=DeepTutor app container (Next.js :3782 + FastAPI :8001 inside the pod; no secrets in this file)
Requires=deeptutor-pod.service
After=deeptutor-pod.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
RestartSec=5
TimeoutStopSec=70
ExecStart=/usr/bin/podman run --rm --replace --pull=never \
  --pod deeptutor --name deeptutor-app \
  --userns=keep-id \
  --read-only \
  --security-opt no-new-privileges \
  --pids-limit 1024 --memory 4g --cpus 4 \
  --tmpfs /tmp:size=512m,mode=1777 --tmpfs /run:size=32m,mode=0755 \
  --tmpfs /var/run:size=8m,mode=0755 --tmpfs /var/log:size=64m,mode=0755 \
  --tmpfs /root:size=16m,mode=0700 --tmpfs /home:size=16m,mode=0755 \
  -v /home/deploy/projects/deeptutor/data:/app/data:U \
  -v /home/deploy/projects/deeptutor/data/user/workspace:/workspace:U \
  -e DEEPTUTOR_WORKSPACE_ROOT=/workspace \
  -e DEEPTUTOR_WORKSPACE_ALLOWED_ROOTS=/workspace \
  -e DEEPTUTOR_SANDBOX_ALLOW_SUBPROCESS=0 \
  ghcr.io/hkuds/deeptutor@sha256:602d5dfbac7430e364069ac6672642cb0d764e046d189bf596d9ddc6b775c535
ExecStop=/usr/bin/podman stop --ignore -t 10 deeptutor-app

[Install]
WantedBy=default.target
